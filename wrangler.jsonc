{
  "$schema": "https://unpkg.com/wrangler@4.132.0/config-schema.json",
  "name": "parkside-parking",
  "account_id": "663aba20dd087e7242771263ce8b2105",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-16",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "mrpark.ai.kr", "custom_domain": true }
  ],
  "vars": {
    "COLLECTION_ENABLED": "true",
    "RETENTION_CONFIGURED": "true",
    "CONTACT_EMAIL": "jinhyeong9568@gmail.com"
  },
  "ratelimits": [
    { "name": "UPLOAD_LIMIT", "namespace_id": "95681301", "simple": { "limit": 10, "period": 60 } },
    { "name": "GLOBAL_LIMIT", "namespace_id": "95681302", "simple": { "limit": 100, "period": 60 } }
  ],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    { "binding": "RECORDS", "bucket_name": "parkside-driving-records" }
  ],
  "observability": { "enabled": false },
  "send_metrics": false
}
